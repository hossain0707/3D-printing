# Copy to .env (never commit real secrets)
MINIMO_ENV=development
MINIMO_TOKEN_PEPPER=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MINIMO_ADMIN_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# This must be true for API to accept public uploads; start with false until secured.
MINIMO_PUBLIC_GENERATION=false
MINIMO_ALLOWED_ORIGINS=http://localhost:8000,https://minimo-3d-printing.vercel.app
MINIMO_DATA_DIR=./data
