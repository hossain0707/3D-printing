# Copy to .env, provide distinct cryptographically random secrets.
# Startup fails closed in production if the secrets are absent or weak.
MINIMO_ENV=development
MINIMO_ENABLE_UPLOADS=false
MINIMO_TOKEN_PEPPER=
MINIMO_ADMIN_KEY=
MINIMO_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MINIMO_DATA_DIR=./data
MINIMO_COLMAP_BINARY=colmap
MINIMO_BLENDER_BINARY=blender
MINIMO_STAGE_TIMEOUT_SECONDS=7200
MINIMO_DATA_RETENTION_DAYS=30
MINIMO_MAX_QUEUED_JOBS=4
